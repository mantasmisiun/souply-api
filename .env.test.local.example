# Integration tests against the local stack. Copy to .env.test.local, then
#   npm run test:local
# souply_test_ci is created empty by scripts/local/initdb; tests/globalSetup.ts
# loads tests/schema/schema.sql into it on the first run.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=souply_app
DB_PASSWORD=souply_local
DB_NAME=souply_test_ci
DB_TIMEZONE=+02:00

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=souply_local
MINIO_SECRET_KEY=souply_local_minio
MINIO_BUCKET=receipts
MINIO_PRODUCT_IMAGES_BUCKET=product-images

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Souply <noreply@souply.lt>

API_PUBLIC_URL=http://localhost:3000
SESSION_JWT_SECRET=local-test-only-not-a-real-secret-000000000000000
