{
  "name": "souply-api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts --ignore receipts/",
    "build": "tsc",
    "start": "node dist/souply-api/src/index.js",
    "receipts:batch": "tsx src/scripts/receiptBatch/importReceiptBatch.ts",
