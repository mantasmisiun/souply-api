    "receipts:matchaudit": "tsx src/scripts/receiptBatch/matchAudit.ts",
    "receipts:stage": "tsx src/scripts/receiptBatch/stageReceiptsOnDevice.ts",
    "receipts:cleanup": "tsx src/scripts/receiptBatch/cleanupTestReceipts.ts",
    "truths:bootstrap": "tsx src/scripts/bootstrapTruthsFromLogs.ts",
    "truths:review": "tsx src/scripts/reviewProvisionalTruth.ts",
    "beta:reinvite": "tsx src/scripts/reinviteBeta.ts",
    "scrape:rimi": "tsx src/scrapers/runRimi.ts",
    "scrape:iki": "tsx src/scrapers/runIki.ts",
    "scrape:barbora": "tsx src/scrapers/runBarbora.ts",
    "scrape:norfa": "tsx src/scrapers/runNorfa.ts",
    "scrape:lidl": "tsx src/scrapers/runLidl.ts",
    "scrape:all": "tsx src/scrapers/runAll.ts",
    "admin": "tsx src/scripts/adminCli.ts",
    "type": "module",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "prepare": "node .husky/install.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
