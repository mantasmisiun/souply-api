# Copy to .env.production and fill in real values. Never commit the
# real file — add .env.production to .gitignore (and .dockerignore
# already excludes it).
#
# cp basket-api/.env.production.example basket-api/.env.production
# chmod 600 basket-api/.env.production

NODE_ENV=production
PORT=3000

# MySQL — container name on the backend network, NOT 192.168.1.212.
# Intra-docker traffic is faster and doesn't leave the host.
DB_HOST=mysql
DB_PORT=3306
DB_USER=basket
DB_PASSWORD=<mysql-password>
DB_NAME=Basket_DB

# MinIO — same network-name rule. PUBLIC_ENDPOINT is what the phone
# uses for presigned URLs; ENDPOINT is what the API uses from inside
# docker. They MUST match the signature domain, so set both via the
# MinIO container's MINIO_SERVER_URL or have the API sign with the
# public endpoint (see below).
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=receipts
# Public URL the phone will actually hit. Set this on the MINIO
# container too (MINIO_SERVER_URL=https://minio.yourdomain.com) so
# presigned URLs are signed with THIS host and verify on WAN.
MINIO_PUBLIC_URL=https://minio.yourdomain.com

# Other
# (add whatever else your app expects — check how your current .env
# looks; copy the keys over, leaving dev-only ones out)
