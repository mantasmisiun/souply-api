# Never commit directly on staging/main — work on dev, promote via PR/push.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "staging" ] || [ "$branch" = "main" ]; then
  echo ""
  echo "🚫 You're on '$branch' — don't commit here."
  echo "   Commit on dev, then promote (gh pr create --base $branch --head dev)."
  echo "   Fix:  git switch dev"
  echo ""
  exit 1
fi

# Warn (don't block) if local dev is behind its remote — committing on a stale
# base is how merge conflicts get born. Cheap: uses already-fetched refs.
if [ "$branch" = "dev" ]; then
  behind=$(git rev-list --count dev..origin/dev 2>/dev/null || echo 0)
  if [ "$behind" -gt 0 ]; then
    echo "⚠️  Local dev is $behind commit(s) behind origin/dev."
    echo "   Consider: git pull --ff-only   (before you build on a stale base)"
  fi
fi
