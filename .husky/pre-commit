# Never commit directly on staging/main — work on dev, promote via PR/push.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "staging" ] || [ "$branch" = "main" ]; then
  echo ""
  echo "🚫 You're on '$branch' — don't commit here."
  echo "   Commit on dev, then promote (gh pr create --base $branch --head dev)."
  echo "   Fix:  git switch dev"
  echo ""
  exit 1
fi

# Warn (don't block) if local dev is behind its remote — committing on a stale
# base is how merge conflicts get born. Cheap: uses already-fetched refs.
if [ "$branch" = "dev" ]; then
  behind=$(git rev-list --count dev..origin/dev 2>/dev/null || echo 0)
  if [ "$behind" -gt 0 ]; then
    echo "⚠️  Local dev is $behind commit(s) behind origin/dev."
    echo "   Consider: git pull --ff-only   (before you build on a stale base)"
  fi
fi

# --- secret scan (gitleaks) -------------------------------------------------
# These repos are public and GitHub keeps refs/pull/* forever, so a secret that
# lands in history cannot be force-pushed away — only deleting the repo fixes
# it. Cheaper to block the commit.
if [ "$SKIP_GITLEAKS" != "1" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --redact .; rc=$?
    if [ $rc -eq 126 ]; then          # older build: unknown subcommand/flag
      gitleaks protect --staged --redact; rc=$?
    fi
    if [ $rc -ne 0 ]; then
      echo ""
      echo "🚫 gitleaks flagged a secret in the staged changes — commit blocked."
      echo "   Remove it, or allowlist a false positive in .gitleaks.toml."
      echo "   Deliberate override:  SKIP_GITLEAKS=1 before your commit command."
      echo ""
      exit 1
    fi
  else
    echo "⚠️  gitleaks not installed — staged changes were NOT scanned."
    echo "   Install:  sudo pacman -S gitleaks"
  fi
fi
