# Local stack (docker-compose.local.yml). Copy to .env.local — no edits needed
# for the basics; every value here is local-only.
#   npm run dev:local     reads this file instead of .env
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=souply_app
DB_PASSWORD=souply_local
DB_NAME=souply_local
DB_TIMEZONE=+02:00

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
# Phone over NetBird: use this PC's NetBird IP here and in API_PUBLIC_URL
# (`netbird status` → NetBird IP), then `npm run local:seed -- rewrite-urls`.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=souply_local
MINIO_SECRET_KEY=souply_local_minio
MINIO_REGION=us-east-1
MINIO_BUCKET=receipts
MINIO_PRODUCT_IMAGES_BUCKET=product-images

# Mailpit (already running on this PC: UI http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Souply <noreply@souply.lt>

API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
APP_SCHEME=souply
APP_ENV=dev
SESSION_JWT_SECRET=local-dev-only-not-a-real-secret-0000000000000000

# Public OAuth client id (same as every env). Apple/Maps keys: copy from .env
# only if you need those flows locally.
GOOGLE_OAUTH_CLIENT_ID=554949767682-oqvvbc2a3klc1tedqvbdotmg4uqkj5s3.apps.googleusercontent.com

# Local-only switches — never on staging/prod.
ALLOW_DEV_AUTH_HEADER=1
ADMIN_OPEN_ACCESS=1
ENABLE_SCHEDULER=false

# Telegram left unset on purpose: alerts are skipped with a warning.
