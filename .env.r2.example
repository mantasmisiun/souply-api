# Source for `npm run local:seed -- images` (copy R2 → local MinIO).
# Copy to .env.r2 and fill in. Use a dedicated READ-ONLY token:
#   Cloudflare → R2 → Manage API tokens → Create → "Object Read only",
#   scoped to the souply buckets. Never reuse prod's read-write keys here.
MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# R2 bucket → local bucket, `:public` = anonymous read locally (served unsigned).
# Local names must match .env.local (MINIO_BUCKET etc.) for the private ones.
MIRROR_BUCKETS=<receipts-bucket>:receipts,<avatars-bucket>:avatars,<covers-bucket>:template-covers,<product-images-bucket>:product-images:public,<logos-bucket>:logos:public

# Stored-URL rewrites applied after every load: OLD=NEW, comma-separated,
# {local} = MINIO_PUBLIC_URL from .env.local. `npm run local:seed -- url-prefixes`
# lists what the loaded dump actually contains.
URL_REWRITES=https://images.souply.lt={local}/product-images,https://logos.souply.lt={local}/logos,https://<account-id>.r2.cloudflarestorage.com/<receipts-bucket>={local}/receipts
